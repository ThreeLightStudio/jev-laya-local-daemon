# Local daemon
DAEMON_HOST=127.0.0.1
# Set to 0 to let the OS pick a free port. When the port is occupied the daemon
# falls back to the next free port; set DAEMON_PORT_STRICT=1 to disable that.
DAEMON_PORT=8787
# DAEMON_PORT_STRICT=0

# Local Laya provider
LAYA_MODEL=convaiinnovations/laya
LAYA_SUBFOLDER=typed-decisions
LAYA_DEVICE=

# Hosted Jev provider (optional)
# Copy this file to .env and paste your Jev / TypeSafe API key below.
# Leave it empty when using only local Laya.
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_API_URL=https://api.typesafe.ai
JEV_TIMEOUT_SECONDS=30
